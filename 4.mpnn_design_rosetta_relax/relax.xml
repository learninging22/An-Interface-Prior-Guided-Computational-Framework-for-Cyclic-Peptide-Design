                stop_when_n_solutions_found="1"
                selector="lowest_energy_selector"
                selector_scorefunction="r15_highhbond_cst">

  <AddResidue res_index="464"/>
  <AddResidue res_index="465"/>
  <AddResidue res_index="466"/>
  <AddResidue res_index="467"/>
 <AddResidue res_index="468"/>
 <AddResidue res_index="469"/>
 <AddResidue res_index="470"/>
 <AddResidue res_index="471"/>
  <AddResidue res_index="472"/>
  <AddResidue res_index="461"/>
  <AddResidue res_index="462"/>

  <SetPivots res1="464" res2="472" res3="462" atom1="CA" atom2="CA" atom3="CA"/>
  
  <CloseBond res1="461" res2="472" atom1="N" atom2="C"
             bondlength="1.33" angle1="121.0" angle2="116.0" torsion="180.0"/>
 <AddPerturber effect="randomize_backbone_by_rama_prepro" >
      <AddResidue index="464"/>
      <AddResidue index="465"/>
      <AddResidue index="466"/>
      <AddResidue index="467"/>
     <AddResidue index="468"/>
