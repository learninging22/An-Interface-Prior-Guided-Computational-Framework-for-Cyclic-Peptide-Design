  <Torsion residue="465" torsion_name="omega" angle="perturb" perturbation_type="gaussian" perturbation_magnitude="1.0"/>

  <Torsion residue="466" torsion_name="phi"   angle="perturb" perturbation_type="gaussian" perturbation_magnitude="1.0"/>
  <Torsion residue="466" torsion_name="psi"   angle="perturb" perturbation_type="gaussian" perturbation_magnitude="2.0"/>
  <Torsion residue="466" torsion_name="omega" angle="perturb" perturbation_type="gaussian" perturbation_magnitude="1.0"/>

  <Torsion residue="467" torsion_name="phi"   angle="perturb" perturbation_type="gaussian" perturbation_magnitude="8.0"/>
