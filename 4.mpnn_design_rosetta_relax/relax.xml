      <AddResidue index="472"/>
      <AddResidue index="461"/>
      <AddResidue index="462"/>   
 </AddPerturber>
  <AddFilter type="loop_bump_check"/>
</GeneralizedKIC>

 <ParsedProtocol name="genkic_perturb_steps">
  <Add mover="connect_termini"/>
  <Add filter="oversat"/>
  <Add filter="total_hbonds"/>
 </ParsedProtocol>

 <GeneralizedKIC name="genkic_perturb" closure_attempts="5" pre_selection_mover="genkic_perturb_steps" stop_when_n_solutions_found="1" selector="lowest_rmsd_selector" selector_scorefunction="r15_highhbond_cst">

  <AddResidue res_index="464"/>
  <AddResidue res_index="465"/>
  <AddResidue res_index="466"/>
  <AddResidue res_index="467"/>
<AddResidue res_index="468"/>
<AddResidue res_index="469"/>
<AddResidue res_index="470"/>
<AddResidue res_index="471"/>
