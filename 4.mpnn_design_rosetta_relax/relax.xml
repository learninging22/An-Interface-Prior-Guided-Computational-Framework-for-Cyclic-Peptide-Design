<ROSETTASCRIPTS>
  <SCOREFXNS>
    <ScoreFunction name="ref2015" weights="ref2015.wts">
    <Reweight scoretype="aspartimide_penalty" weight="1.0"/>
</ScoreFunction>

        <ScoreFunction name="r15_cst" weights="ref2015_cst.wts" >
            <Reweight scoretype="chainbreak" weight="40.0" />
            <Reweight scoretype="aspartimide_penalty" weight="1.0" />
        </ScoreFunction>
   
        <ScoreFunction name="r15_highhbond_cst" weights="ref2015_cst.wts" >
            <Reweight scoretype="chainbreak" weight="40.0" />
            <Reweight scoretype="aspartimide_penalty" weight="1.0" />
            <Reweight scoretype="hbond_sr_bb" weight="10.0" />
            <Reweight scoretype="hbond_lr_bb" weight="10.0" />
            <Reweight scoretype="hbond_bb_sc" weight="5.0" />
            <Reweight scoretype="hbond_sc" weight="3.0" />
            <Reweight scoretype="fa_elec" weight="2.0" />
        </ScoreFunction>
  
        <ScoreFunction name="r15_highhbond_aacomp_cst" weights="ref2015_cst.wts" >
            <Reweight scoretype="chainbreak" weight="40.0" />
            <Reweight scoretype="aspartimide_penalty" weight="1.0" />
            <Reweight scoretype="hbond_sr_bb" weight="10.0" />
            <Reweight scoretype="hbond_lr_bb" weight="10.0" />
            <Reweight scoretype="hbond_bb_sc" weight="5.0" />
            <Reweight scoretype="hbond_sc" weight="3.0" />
            <Reweight scoretype="fa_elec" weight="2.0" />
            <Reweight scoretype="aa_composition" weight="1.0" />
        </ScoreFunction>
        
<ScoreFunction name="r15_soft" weights="ref2015_soft.wts">
<Reweight scoretype="aspartimide_penalty" weight="1.0"/>
<Reweight scoretype="atom_pair_constraint" weight="1.0"/>
<Reweight scoretype="angle_constraint" weight="1.0"/>
<Reweight scoretype="dihedral_constraint" weight="1.0"/>
<Reweight scoretype="aa_composition" weight="1.0"/>
</ScoreFunction>
  </SCOREFXNS>
  
   <RESIDUE_SELECTORS>
        <Chain name="A_chain" chains="A"/>
   !-- Select chain H -->
        <Chain name="H_chain" chains="H"/>

        <!-- Identify target residues to retain in chain H -->
        <And name="target_residues">
            <Chain chains="H"/>
            <Index resnums="558,559,560,561,562,563"/>
        </And>

        <!-- Residues in chain H to delete (inverse selection) -->
        <And name="non_target_H_residues">
            <Chain chains="H"/>
            <Not selector="target_residues"/>
        </And>

        <Index name="select_peptide" resnums="461-472" />
        <Index name="select_stub" resnums="462-463,465" />

        <Index name="select_pep_start" resnums="461" />
        <Index name="select_pep_end" resnums="472" />

        <Not name="select_target" selector="select_peptide" />

        <Index name="select_design_positions" resnums="462-463,465,467,468,469,470,471,472" />
    
        <Neighborhood name="select_interface" resnums="461-465" distance="8.0" />

        <Not name="select_not_interface" selector="select_interface" />

        <And name="select_target_far_from_interface"
            selectors="select_not_interface,select_target"
        />

        <Layer name="select_core" select_core="true" select_boundary="false"
            select_surface="false"
        />

        <And name="select_hydrophobic_positions"
            selectors="select_design_positions,select_core"
        />

        <Not name="select_nonhydrophobic_positions" selector="select_hydrophobic_positions" />

        <And name="select_nonhydrophobic_design_positions"
            selectors="select_nonhydrophobic_positions,select_design_positions"/>
 </RESIDUE_SELECTORS>
 
 
 
 <TASKOPERATIONS>
 <IncludeCurrent name="use_input_rotamer" />
 <ExtraRotamersGeneric name="extrarot" ex1="1" ex2="1" ex3="0" ex4="0"
            extrachi_cutoff="5"/>
   <OperateOnResidueSubset name="no_repack_target" selector="select_target" >
            <PreventRepackingRLT />
        </OperateOnResidueSubset>
   <OperateOnResidueSubset name="no_repack_target_far_from_interface"
            selector="select_target_far_from_interface">
            <PreventRepackingRLT />
        </OperateOnResidueSubset>
<OperateOnResidueSubset name="no_design_stub" selector="select_stub">
<RestrictToRepackingRLT/>
</OperateOnResidueSubset>
<OperateOnResidueSubset name="no_design_target" selector="select_target">
<RestrictToRepackingRLT/>
</OperateOnResidueSubset>
    </TASKOPERATIONS>
 
<FILTERS>
  <ScoreType name="score" scorefxn="ref2015" score_type="total_score" threshold="0"/>
  <ScoreType name="mc_score" scorefxn="r15_highhbond_aacomp_cst" score_type="total_score" threshold="-100"/>
  <OversaturatedHbondAcceptorFilter name="oversat" scorefxn="ref2015" max_allowed_oversaturated="1" consider_mainchain_only="false"/>
  <ScoreType name="score_low" scorefxn="ref2015" score_type="total_score" threshold="0"/>
  <PeptideInternalHbondsFilter name="total_hbonds" hbond_cutoff="0" exclusion_distance="1" residue_selector="select_peptide"/>
  <ShapeComplementarity name="shape1" min_sc="0.6" min_interface="100" residue_selector1="A_chain"
                          residue_selector2="select_peptide" verbose="false" use_rosetta_radii="true" />
  <ShapeComplementarity name="shape2" min_sc="0.65" min_interface="150" residue_selector1="A_chain"
                          residue_selector2="select_peptide" verbose="false" use_rosetta_radii="true" />
  <ScoreType name="low_stringency_clash" scorefxn="ref2015" score_type="fa_rep"
            threshold="400"/>
  <CombinedValue name="mc_filter" threshold="-100">
    <Add filter_name="mc_score" factor="1.0"/>
  </CombinedValue>
</FILTERS>
 
  <MOVERS>
  <DeleteRegionMover name="delete_H_chain_non_target" residue_selector="non_target_H_residues"/>

    <!-- Build 8 residues -->
    <PeptideStubMover name="build_peptide">      
      <Append anchor_rsd="466" resname="ALA" repeat="6"/>
    </PeptideStubMover> 
    
    <SetTorsion name="set_torsion">
      <Torsion residue="461-472" torsion_name="omega" angle="180"/>
    </SetTorsion>           
    
    <SetTorsion name="perturb_tors">
  <Torsion residue="462" torsion_name="phi"   angle="perturb" perturbation_type="gaussian" perturbation_magnitude="8.0"/>
  <Torsion residue="462" torsion_name="psi"   angle="perturb" perturbation_type="gaussian" perturbation_magnitude="8.0"/>
  <Torsion residue="462" torsion_name="omega" angle="perturb" perturbation_type="gaussian" perturbation_magnitude="1.0"/>

  <Torsion residue="463" torsion_name="phi"   angle="perturb" perturbation_type="gaussian" perturbation_magnitude="8.0"/>
  <Torsion residue="463" torsion_name="psi"   angle="perturb" perturbation_type="gaussian" perturbation_magnitude="8.0"/>
  <Torsion residue="463" torsion_name="omega" angle="perturb" perturbation_type="gaussian" perturbation_magnitude="1.0"/>

  <Torsion residue="464" torsion_name="phi"   angle="perturb" perturbation_type="gaussian" perturbation_magnitude="1.0"/>
  <Torsion residue="464" torsion_name="psi"   angle="perturb" perturbation_type="gaussian" perturbation_magnitude="2.0"/>
  <Torsion residue="464" torsion_name="omega" angle="perturb" perturbation_type="gaussian" perturbation_magnitude="1.0"/>

  <Torsion residue="465" torsion_name="phi"   angle="perturb" perturbation_type="gaussian" perturbation_magnitude="8.0"/>
